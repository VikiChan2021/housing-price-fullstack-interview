# Optional overrides for `docker compose up --build -d --wait`.
WEB_PORT=3000
ML_API_PORT=8000
ESTIMATOR_API_PORT=8001
MARKET_API_PORT=8080

ML_API_BASE_URL=http://ml-api:8000
ESTIMATOR_API_BASE_URL=http://estimator-api:8001
MARKET_API_BASE_URL=http://market-api:8080
ML_API_TIMEOUT_SECONDS=5
WEB_API_TIMEOUT_SECONDS=10
ML_MODEL_PATH=/app/models/model.joblib
ML_METADATA_PATH=/app/models/metadata.json
MARKET_DATA_PATH=/app/data/house-price-dataset.csv
MARKET_CACHE_TTL_SECONDS=300
MARKET_CACHE_MAX_ENTRIES=256
LOG_LEVEL=INFO
